	<!--
		Wet-pale skin: a pale blue for the nureonago, paler than both the vanilla Skin_Blue
		(100,165,193) and the sea slime's PMM_Skin_SeaFoam (158,205,224) - the damp, faintly
		blue cast of a slime mimicking a human woman. Same Biotech skin-override parent.
	-->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_WetPale</defName>
		<label>wet-pale skin</label>
		<labelShortAdj>wet-pale</labelShortAdj>
		<description>Carriers of this gene produce a pale, watery pigment that turns their skin a faint, damp-looking blue.</description>
		<skinColorOverride>(185, 213, 233, 191)</skinColorOverride>
		<displayOrderInCategory>89</displayOrderInCategory>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>rain</symbol></li>
				<li><symbol>dew</symbol></li>
				<li><symbol>damp</symbol></li>
			</prefixSymbols>
		</symbolPack>
	</GeneDef>

	<!--
		Fastidious gene: the nureonago's devoted-housekeeper trait. Unlike the slime gel gene
		(which uses statOffsets to RAISE the ambient filth rate), this uses statFactors to
		multiply it well below a human's, and to speed up cleaning. Multiplicative so it
		stacks sensibly with the gel gene's flat offset.
	-->
	<GeneDef>
		<defName>PMM_Gene_Fastidious</defName>
		<label>fastidious</label>
		<labelShortAdj>fastidious</labelShortAdj>
		<description>Carriers of this gene are instinctive, devoted housekeepers. They shed far less filth than an ordinary person and clean with brisk efficiency.</description>
		<displayCategory>Miscellaneous</displayCategory>
		<canGenerateInGeneSet>false</canGenerateInGeneSet>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statFactors>
			<FilthRate>0.2</FilthRate>
			<CleaningSpeed>1.5</CleaningSpeed>
		</statFactors>
		<customEffectDescriptions>
			<li>Sheds 80% less filth than a normal person.</li>
			<li>Cleans 50% faster.</li>
		</customEffectDescriptions>
	</GeneDef>

</Defs>
