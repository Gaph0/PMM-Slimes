<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		Slime gel gene. Carries the slime-specific physiology that pure XML cannot express:
		the C# GeneClass (PMM_SlimeFaction.Gene_SlimeGel) and its Harmony patches apply these at runtime:
		  - raises the carrier's ambient Filth Rate (4x);
		  - makes the carrier drop Filth_Slime instead of the default pawn filth (never trash);
		  - periodically drops slime jelly on the ground beneath the carrier (hidden hediff added in PostAdd);
		  - hair always renders in the carrier's skin colour, and tattoos can never be applied;
		  - all damage to the carrier lands as bruises (no bones to break, no skin to cut);
		  - butchering the carrier yields only slime jelly, no meat or skin.
		The gene is endogenes-only and not part of the tradeable gene pool.
	-->
	<GeneDef>
		<defName>PMM_Gene_SlimeGel</defName>
		<label>slime gel</label>
		<labelShortAdj>gelatinous</labelShortAdj>
		<description>Carriers of this gene have a gelatinous, semi-liquid body. They constantly shed a slick of slime filth, and their bodies periodically ooze blobs of nourishing slime jelly. With no bones and no skin, every wound they suffer is a bruise.</description>
		<geneClass>PMM_SlimeFaction.Gene_SlimeGel</geneClass>
		<displayCategory>Miscellaneous</displayCategory>
		<canGenerateInGeneSet>false</canGenerateInGeneSet>
		<biostatCpx>1</biostatCpx>
		<biostatMet>3</biostatMet>
		<!-- Raise ambient filth rate from the pawn default (1) to 4, a clear slime-trail feel. -->
		<statOffsets>
			<FilthRate>4</FilthRate>
		</statOffsets>
		<customEffectDescriptions>
			<li>Constantly sheds slime filth.</li>
			<li>Periodically drops slime jelly.</li>
			<li>Boneless, skinless body: all wounds are bruises, and butchering yields only slime jelly.</li>
		</customEffectDescriptions>
	</GeneDef>

	<!--
		All slime skin colours are semi-transparent gel. Every slime skin gene below carries
		a 0.75 alpha (the 4th component, ~191/255 opacity), so a slime's body reads as a
		translucent, jelly-like mass rather than opaque flesh. Each uses Biotech's abstract
		GeneSkinColorOverride parent, so it carries the skin-colour-override behaviour and
		stays out of the tradeable pool. Biotech-only, like every skin-colour gene.

		The five base slime colours reuse the exact vanilla RGB values so a slime matches
		its vanilla-skinned counterpart in hue, just translucent:
		  Skin_Blue (100,165,193), Skin_DeepRed (150,62,62), Skin_Purple (97,87,195),
		  Skin_SlateGray (90,90,90), Skin_PaleYellow (193,165,99).
	-->

	<!-- Blue slime gel: vanilla Skin_Blue at 0.75 alpha. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
		<defName>PMM_Skin_Blue</defName>
		<label>blue gel skin</label>
		<labelShortAdj>blue gel</labelShortAdj>
		<description>Carriers of this gene have translucent, blue gelatinous skin.</description>
		<skinColorOverride>(100, 165, 193, 191)</skinColorOverride>
		<displayOrderInCategory>88</displayOrderInCategory>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>blue</symbol></li>
				<li><symbol>gel</symbol></li>
				<li><symbol>ooze</symbol></li>
			</prefixSymbols>
		</symbolPack>
	</GeneDef>

	<!-- Red slime gel: vanilla Skin_DeepRed at 0.75 alpha. -->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
