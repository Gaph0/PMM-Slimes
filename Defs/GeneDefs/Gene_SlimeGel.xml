	<!--
		Sea foam skin: a light blue skin colour for the sea slime, paler than the vanilla
		Skin_Blue (100,165,193), now at 0.75 alpha like every slime gel. Same Biotech parent.
	-->
	<GeneDef ParentName="GeneSkinColorOverride" MayRequire="Ludeon.RimWorld.Biotech">
