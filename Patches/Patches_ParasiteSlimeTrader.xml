<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--
		Parasite slime acquisition: a guaranteed single blob in exotic-goods trader
		stock (the item's ExoticMisc tradeTag also lets the vanilla tag-based stock
		generators roll it sporadically). One blob per exotic trader, never anywhere
		else: very rare, but deterministically findable.
	-->
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>

			<li Class="PatchOperationAdd">
				<xpath>Defs/TraderKindDef[defName="Caravan_Outlander_Exotic"]/stockGenerators</xpath>
				<value>
					<li Class="StockGenerator_SingleDef">
						<thingDef>PMM_ParasiteSlime</thingDef>
						<countRange>1~1</countRange>
					</li>
				</value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/TraderKindDef[defName="Orbital_Exotic"]/stockGenerators</xpath>
				<value>
					<li Class="StockGenerator_SingleDef">
						<thingDef>PMM_ParasiteSlime</thingDef>
						<countRange>1~1</countRange>
					</li>
				</value>
			</li>

		</operations>
	</Operation>

</Patch>
